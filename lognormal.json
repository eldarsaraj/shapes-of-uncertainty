}],"key":"SpPsbeU8V7"}],"key":"mEW4b9uYG2"}],"key":"lN2Zr9Zqh2"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"In these environments, uncertainty does not accumulate symmetrically: it stretches.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"w2apQhy1cu"}],"key":"O80QZdV9Su"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"This is the world of the ","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"rn1ZIH1FiW"},{"type":"strong","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"lognormal distribution","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"l3ehFg1hDv"}],"key":"ijEWGknfbo"},{"type":"text","value":".","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"lIBir2XVcX"}],"key":"tejGlmA9ub"},{"type":"thematicBreak","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"Ug1BFflGcH"},{"type":"heading","depth":2,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"When growth multiplies","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"v7REU3FmwC"}],"identifier":"when-growth-multiplies","label":"When growth multiplies","html_id":"when-growth-multiplies","implicit":true,"key":"KoOReXKpev"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Suppose you invest money in a fund that earns a return each year. One year it grows by 5%, another year it falls by 3%, another year it grows by 8%. Each year’s outcome multiplies what came before.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"s3UAcLpXnQ"}],"key":"keKRrJuPk1"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"If you begin with $100 and earn 10%, you now have $110. If you then lose 10%, you do not return to $100. You fall to $99. ","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"UX1J4CZBxB"},{"type":"strong","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Loss and gain do not cancel symmetrically when growth is multiplicative","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"dYhpheEpUW"}],"key":"uk36mGO8rE"},{"type":"text","value":".","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"XoF6Vzxqma"}],"key":"pKFDHkaSyy"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"This is the key distinction.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"ZrUNfGyfD7"}],"key":"NoAkE1GA5L"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"In additive systems, deviations push in opposite directions and tend to wash out. In multiplicative systems, deviations compound. Small differences, repeated over time, ","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"uEjaOt1axT"},{"type":"strong","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"produce widening gaps","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"dHoqzDE6Ji"}],"key":"Cmg5Jr608j"},{"type":"text","value":".","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"PGxh01DzL1"}],"key":"k4srpLomYq"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"The lognormal distribution emerges when many small percentage changes multiply together.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"J3OkYKXeUl"}],"key":"UkQTPtW1lp"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Instead of modeling the raw values directly, we model their logarithms.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"M5Ir7h7VQg"}],"key":"BgZKBP04eQ"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"A logarithm is simply a way of transforming multiplicative change into additive change. When we take the logarithm of a number, we are no longer measuring the number itself, but the exponent to which a base (usually 10 or the constant ","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"kLHkf8i451"}],"key":"wDtfOuwFxT"},{"type":"math","value":"e","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"tight":true,"html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>e</mi></mrow><annotation encoding=\"application/x-tex\">e</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">e</span></span></span></span></span>","enumerator":"1","key":"MRuEnGIbrL"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":") must be raised to produce that number.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"AmmJZ7xlRX"}],"key":"Z3qCmUGrfI"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"This may sound abstract, but its practical meaning is straightforward: percentage changes become differences. If something grows by 10% and then by another 10%, those growth steps multiply in ordinary space. But in logarithmic space, they add. By taking logarithms, we convert compounding processes into additive ones. If those additive changes fluctuate symmetrically—pushed up and down by many small influences—their distribution tends to resemble the normal curve. When we transform back to the original scale, the symmetry disappears and the familiar right-skewed lognormal shape emerges.","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"H6M6aDHT5h"}],"key":"hXgp3STAMN"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"The result is a shape that looks very different from the familiar bell curve.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"Y5U9MCudDH"}],"key":"f7jlum5Fyy"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/shapes-of-uncertainty/build/lognormal-chart-37981cbc77498d8b568569ee98592514.png","alt":"Lognormal","width":"\"70%\"","key":"URv8r9Ezza","urlSource":"images/lognormal-chart.png","urlOptimized":"/shapes-of-uncertainty/build/lognormal-chart-37981cbc77498d8b568569ee98592514.webp"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"fig-lognorm","identifier":"fig-lognorm","html_id":"fig-lognorm","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"MWvsPxTsEb"},{"type":"text","value":"1","key":"sE304Bry0P"},{"type":"text","value":":","key":"G21J7ftKba"}],"template":"Figure %s:","key":"Pj9SVbOiDq"},{"type":"text","value":"The shape of the lognormal distribution looks similar to normal distribution.","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"ilRNEKKCkn"}],"key":"zN42Q5j1ip"}],"key":"U2VkRB5zvd"}],"label":"fig-lognorm","identifier":"fig-lognorm","enumerator":"1","html_id":"fig-lognorm","key":"dTKJArpf1Z"},{"type":"thematicBreak","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"jBJzOKVAL9"},{"type":"heading","depth":2,"position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"The shape of compounding uncertainty","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"k1e6rCMabU"}],"identifier":"the-shape-of-compounding-uncertainty","label":"The shape of compounding uncertainty","html_id":"the-shape-of-compounding-uncertainty","implicit":true,"key":"PZ0e9nYmkW"},{"type":"paragraph","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"Visually, the lognormal distribution is skewed to the right.","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"BEMz3ut8YZ"}],"key":"fjaWACuDcU"},{"type":"paragraph","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"There is a concentration of outcomes near a lower region, but a long, stretching tail extends toward large values.","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"BxMlua8T8Y"}],"key":"gKYVXh6sVH"},{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"Most observations are modest, but a few are enormous.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"B63wDMlTGY"}],"key":"wKD4UCJBM5"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"Unlike the normal distribution, there is no symmetry around the average. The mean is pulled upward by rare but very large values.","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"zqjKHksThp"}],"key":"XHt0L1UV2N"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"In such a distribution, the “typical” case and the “average” case are not the same.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"Q66LmhdRHs"}],"key":"MFvA5xFtxZ"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"If income follows a lognormal pattern—as it often approximately does—most people earn less than the average income. The mean is lifted by a relatively small number of very high earners.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"QP0Kdru7go"}],"key":"WCqc6wSOuB"},{"type":"paragraph","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"The same pattern appears in firm sizes, city populations, investment returns, and biological growth processes.","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"X6nRiyjw6f"}],"key":"ySKT81ik1V"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Growth hides risk because compounding creates dispersion.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"JgVcme9NuD"}],"key":"jaWvOGu7W3"},{"type":"thematicBreak","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"SHQTVCIFkd"},{"type":"heading","depth":2,"position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"Why the average becomes misleading","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"KPf9cLTbVA"}],"identifier":"why-the-average-becomes-misleading","label":"Why the average becomes misleading","html_id":"why-the-average-becomes-misleading","implicit":true,"key":"c3sRproKlv"},{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"In additive environments, the average corresponds to something you are likely to encounter. In multiplicative environments, this intuition breaks down.","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"vm5Jkns01v"}],"key":"fpkjL3u4lk"},{"type":"paragraph","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"The arithmetic mean in a lognormal system is heavily influenced by rare extreme values. These extremes may be infrequent, but their magnitude stretches the average upward.","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"IuoeBfiGHW"}],"key":"Lcr4aR2g3o"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"If you ask, “What is the average outcome?” you may receive a number that few individuals actually experience.","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"y5XA4SWozR"}],"key":"vlVNK3rfcG"},{"type":"paragraph","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"A more informative measure in such systems is often the median—the middle case—rather than the mean. The median reflects the typical lived experience more faithfully.","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"qOQ2jI2pLE"}],"key":"kmnxLCraXX"},{"type":"paragraph","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"This difference between mean and median is not technical trivia. It shapes how we interpret inequality, risk, and opportunity.","position":{"start":{"line":95,"column":1},"end"