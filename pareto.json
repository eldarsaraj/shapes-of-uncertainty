lumn":1},"end":{"line":18,"column":1}},"key":"w4ZnEydjzz"}],"key":"VPY6S6qrtm"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"In these environments, a small number of cases account for a large share of the total. A few cities contain most of the population. A few firms control most of the market. A few creators capture most of the attention. A few scientific papers receive most of the citations.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"W553PxFpCM"}],"key":"lTzhjEGyFW"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"This is the world of the ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"mkcza8Yvfw"},{"type":"strong","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Pareto distribution","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"Ouwr56CjYs"}],"key":"DxMx5cIPh4"},{"type":"text","value":", often associated with what are called ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"F2AiwNDCme"},{"type":"strong","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"power laws","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"RSrYOfWK6K"}],"key":"XMOlYuqKGd"},{"type":"text","value":".","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"BPUxy2DYmE"}],"key":"hoa3DQm6JI"},{"type":"thematicBreak","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"guKSnCpjWd"},{"type":"heading","depth":2,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"From growth to dominance","position":{"start":{"line":26,"column":1},"end":{"line":26,"