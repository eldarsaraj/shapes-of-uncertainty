7em;\">α</span></span></span></span>","key":"bkHuIT4gLJ"},{"type":"text","value":" controls how heavy the tail is. Smaller values of ","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"tNISKzegkB"},{"type":"inlineMath","value":"\\alpha","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>α</mi></mrow><annotation encoding=\"application/x-tex\">\\alpha</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0037em;\">α</span></span></span></span>","key":"sOzjCU5puS"},{"type":"text","value":" mean heavier tails, which means extreme values become more influential.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"dRatb42zKH"}],"key":"UrOjqtrS1E"},{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"You do not need to focus on the formula. What matters is its implication.","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"Ga758bKvRD"}],"key":"O129mtHFxa"},{"type":"paragraph","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"If you double the size of an event, its probability does not collapse dramatically. It declines gradually. Large events remain structurally relevant.","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"PpqJdLWj9E"}],"key":"wQynFFBX3X"},{"type":"paragraph","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"This is what makes Pareto systems different from normal ones. In normal systems, extremes thin out rapidly. In Pareto systems, extremes thin slowly.","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"yyArYfhLCE"}],"key":"DXe74nLVFS"},{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"The difference between “rapidly” and “slowly” changes everything.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"qQxI5yr4I8"}],"key":"OMRBpQAAmX"},{"type":"thematicBreak","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"zkKrxAIEJT"},{"type":"heading","depth":2,"position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"The properties of extreme-dominated uncertainty","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"R5vpRBkwWd"}],"identifier":"the-properties-of-extreme-dominated-uncertainty","label":"The properties of extreme-dominated uncertainty","html_id":"the-properties-of-extreme-dominated-uncertainty","implicit":true,"key":"OCT5nERM7d"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"Let us apply the property lens carefully.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"YsX5oFu45u"}],"key":"wAfgGJSIwY"},{"type":"heading","depth":3,"position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"Typicality","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"rqza5eUUBr"}],"identifier":"typicality","label":"Typicality","html_id":"typicality","implicit":true,"key":"T4zifSx0lK"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"There is often a lower bound below which values do not fall. Many observations cluster near this minimum.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"uWBhgUxyfe"}],"key":"DHXu5sWF8b"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"However, there is no central peak in the way there is for the normal distribution. The “typical” case may represent the majority of instances, but it does not represent the majority of impact.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"QpHJxwiwI8"}],"key":"gilYYf1Nw9"},{"type":"paragraph","position":{"start":{"line":85,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"Most firms are small.","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"Gbe1tSswvD"},{"type":"break","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"xgMY0S4dhQ"},{"type":"text","value":"Most videos have few views.","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"DJ95k2yvqM"},{"type":"break","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"BreDmEvhIU"},{"type":"text","value":"Most books sell modestly.","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"tDodePd6i8"}],"key":"foe1JT4dHh"},{"type":"paragraph","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"Yet a small number dominate the totals.","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"OolAeL8aeo"}],"key":"LceClPHerc"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"Typicality describes frequency, not influence.","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"GD4Vf9l5WC"}],"key":"AnMILxobuQ"},{"type":"heading","depth":3,"position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"Extremeness","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"vlBzjkwyvL"}],"identifier":"extremeness","label":"Extremeness","html_id":"extremeness","implicit":true,"key":"UeA0Ptg4zb"},{"type":"paragraph","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"Extremes are structurally central. They are rare in count but dominant in consequence.","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"dG437YxZNi"}],"key":"dhiOksLFHW"},{"type":"paragraph","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"text","value":"In income distributions shaped by power laws, the top few percent may account for a large fraction of total wealth. In scientific citations, a small number of papers may receive most references.","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"o0bJS7hPWh"}],"key":"NjCNeKFnZG"},{"type":"paragraph","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"Ignoring extremes in such systems leads to severe misjudgment.","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"W43a68nq4e"}],"key":"nPusEy00zg"},{"type":"heading","depth":3,"position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"text","value":"Memory","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"key":"oIyR3XJYWV"}],"identifier":"memory","label":"Memory","html_id":"memory","implicit":true,"key":"D7pHCyWIxe"},{"type":"paragraph","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"The distribution itself does not imply memory between individual observations. However, many real-world Pareto systems emerge from reinforcing mechanisms: reputation builds on reputation, success attracts attention, wealth generates investment opportunities.","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"oH4lUQDidR"}],"key":"fGnUGjNMiL"},{"type":"paragraph","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"children":[{"type":"text","value":"These feedback processes create cumulative advantage.","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"SMn2SSovzB"}],"key":"Z0EQBMHOg8"},{"type":"paragraph","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"text","value":"In this sense, while the mathematical form does not require memory, many real systems that produce power laws involve positive feedback.","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"JlZyzgFROj"}],"key":"XaaBXl0RAd"},{"type":"heading","depth":3,"position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"text","value":"Accumulation","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"yq57FTd3sU"}],"identifier":"accumulation","label":"Accumulation","html_id":"accumulation","implicit":true,"key":"FX9QgqNVxN"},{"type":"paragraph","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"text","value":"Accumulation is amplifying. Differences widen over time. Early advantages can cascade into dominant positions.","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"tc5dwEHwWt"}],"key":"voi8TlyJpd"},{"type":"paragraph","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"text","value":"Unlike additive systems where deviations wash out, here deviations compound and concentrate.","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"GAbLb9Jwo8"}],"key":"u1jDgzN9Wd"},{"type":"heading","depth":3,"position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"text","value":"Predictive Ho