","spread":true,"position":{"start":{"line":134,"column":1},"end":{"line":134,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Natural disaster magnitudes","position":{"start":{"line":134,"column":1},"end":{"line":134,"column":1}},"key":"ZsOR4JHm7A"}],"key":"zABwWn9kJI"}],"key":"UtfePcsAbs"},{"type":"listItem","spread":true,"position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Insurance losses","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"ghUXIl3dXU"}],"key":"f0lCURaPZo"}],"key":"qEmg9hGyQj"},{"type":"listItem","spread":true,"position":{"start":{"line":136,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Word frequencies in language","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"eminoRu601"}],"key":"VVkVKtJprG"}],"key":"kGUlBxajZJ"}],"key":"LWQQ0Rlg94"},{"type":"paragraph","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"text","value":"In language, for example, a small number of words account for a large proportion of usage. In finance, a small number of days account for a large fraction of long-term returns.","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"JYQ0fwPt34"}],"key":"bPRhMuR5am"},{"type":"paragraph","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"text","value":"These systems often feel unfair, unstable, or unpredictable because most of the impact resides in rare, extreme cases.","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"EmoKcD6GZD"}],"key":"PZcefbS4dv"},{"type":"paragraph","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"children":[{"type":"text","value":"They do not resemble the stable hills of the normal distribution. They resemble cliffs and plateaus.","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"key":"Ayf7Cu8Zdo"}],"key":"GeTw6SQjIZ"},{"type":"thematicBreak","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"bAJ41rexqH"},{"type":"heading","depth":2,"position":{"start":{"line":146,"column":1},"end":{"line":146,"column":1}},"children":[{"type":"text","value":"Why averages become unreliable","position":{"start":{"line":146,"column":1},"end":{"line":146,"column":1}},"key":"rab0TvRC4X"}],"identifier":"why-averages-become-unreliable","label":"Why averages become unreliable","html_id":"why-averages-become-unreliable","implicit":true,"key":"a24Up6vkkB"},{"type":"paragraph","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"children":[{"type":"text","value":"In extreme-dominated systems, the arithmetic mean can be unstable or misleading.","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"key":"Pi60JE5Nvj"}],"key":"VjdrohiqPj"},{"type":"paragraph","position":{"start":{"line":150,"column":1},"end":{"line":150,"column":1}},"children":[{"type":"text","value":"If rare events carry enormous magnitude, a single new observation can dramatically shift the average.","position":{"start":{"line":150,"column":1},"end":{"line":150,"column":1}},"key":"wJRzu8Rssv"}],"key":"UEbaMGWjjA"},{"type":"paragraph","position":{"start":{"line":152,"column":1},"end":{"line":152,"column":1}},"children":[{"type":"text","value":"Planning based on “average performance” in such environments may create a false sense of security.","position":{"start":{"line":152,"column":1},"end":{"line":152,"column":1}},"key":"TkO0dAB7Ge"}],"key":"FfFI6VGnEY"},{"type":"paragraph","position":{"start":{"line":154,"column":1},"end":{"line":154,"column":1}},"children":[{"type":"text","value":"For example, if most years are calm but occasional catastrophic events cause massive damage, planning only for the average year can lead to ruin.","position":{"start":{"line":154,"column":1},"end":{"line":154,"column":1}},"key":"AXHb5b49u2"}],"key":"vazKIEEAVx"},{"type":"paragraph","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"children":[{"type":"text","value":"In such systems, risk management must focus explicitly on tail events.","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"HsSUe5wnUq"}],"key":"UHqU226hhL"},{"type":"paragraph","position":{"start":{"line":158,"column":1},"end":{"line":158,"column":1}},"children":[{"type":"text","value":"The central mass of the distribution does not define the system. The tail does.","position":{"start":{"line":158,"column":1},"end":{"line":158,"column":1}},"key":"KC8POAEYAg"}],"key":"w3QEQMwtI8"},{"type":"thematicBreak","position":{"start":{"line":160,"column":1},"end":{"line":160,"column":1}},"key":"ILUlZejPE9"},{"type":"heading","depth":2,"position":{"start":{"line":162,"column":1},"end":{"line":162,"column":1}},"children":[{"type":"text","value":"How to act when extremes dominate","position":{"start":{"line":162,"column":1},"end":{"line":162,"column":1}},"key":"vzBI8yOxP1"}],"identifier":"how-to-act-when-extremes-dominate","label":"How to act when extremes dominate","html_id":"how-to-act-when-extremes-dominate","implicit":true,"key":"KrwmKk4qWy"},{"type":"paragraph","position":{"start":{"line":164,"column":1},"end":{"line":164,"column":1}},"children":[{"type":"text","value":"In Pareto environments, resilience becomes more important than optimization.","position":{"start":{"line":164,"column":1},"end":{"line":164,"column":1}},"key":"RHYmgvA6iw"}],"key":"ffP7DN3nZZ"},{"type":"paragraph","position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"children":[{"type":"text","value":"You must prepare for rare but consequential events. You must design systems that can survive large shocks.","position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"key":"FuTWYu5XLU