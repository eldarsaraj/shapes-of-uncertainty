column":1},"end":{"line":36,"column":1}},"key":"FXAIGOKmje"}],"key":"HNKSWSOnnn"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"If you draw the shape of such a distribution, you would see many small values clustered near the lower bound, and a long, gradually declining tail stretching far to the right.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"q9FOg5caAE"}],"key":"sXAiYEbbYK"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/shapes-of-uncertainty/build/pareto-chart-c97ea82ec8bd629a1de3b3b29cb52074.png","alt":"Pareto","width":"\"70%\"","key":"s7xCpbUwYC","urlSource":"images/pareto-chart.png","urlOptimized":"/shapes-of-uncertainty/build/pareto-chart-c97ea82ec8bd629a1de3b3b29cb52074.webp"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"fig-pareto","identifier":"fig-pareto","html_id":"fig-pareto","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"AdsJANrffY"},{"type":"text","value":"1","key":"NlMUBWZIzL"},{"type":"text","value":":","key":"LX1i4u4KUc"}],"template":"Figure %s:","key":"fzDjjCaSxD"},{"type":"text","value":"The shape of the Pareto distribution.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"HBpOnQvsgM"}],"key":"CwR6sItoqK"}],"key":"XoNVWU8HZl"}],"label":"fig-pareto","identifier":"fig-pareto","enumerator":"1","html_id":"fig-pareto","key":"zyU0muVh71"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"There is no meaningful symmetry. There is no stabilizing center that dominates the mass.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"D9hS050yXo"}],"key":"idzBl5DGWt"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Instead, the system is governed by scale.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"a5HPJA2Dfz"}],"key":"Srx4vAJ524"},{"type":"thematicBreak","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"MFsMcTx6xb"},{"type":"heading","depth":2,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"The structure of power laws","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"B8HdKdXcL7"}],"identifier":"the-structure-of-power-laws","label":"The structure of power laws","html_id":"the-structure-of-power-laws","implicit":true,"key":"Y4yC6ezAtO"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"Mathematically, a Pareto distribution has a probability that decreases according to a power of the size. In simplified form, it behaves like:","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"r1cwvhNWcq"}],"key":"nVntFX9jus"},{"type":"math","value":"P(X > x) \\propto x^{-\\alpha}","position":{"start":{"line":59,"column":1},"end":{"line":61,"column":1}},"html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>P</mi><mo stretchy=\"false\">(</mo><mi>X</mi><mo>&gt;</mo><mi>x</mi><mo stretchy=\"false\">)</mo><mo>∝</mo><msup><mi>x</mi><mrow><mo>−</mo><mi>α</mi></mrow></msup></mrow><annotation encoding=\"application/x-tex\">P(X &gt; x) \\propto x^{-\\alpha}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.13889em;\">P</span><span class=\"mopen\">(</span><span cl