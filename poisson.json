":1}},"key":"bnETs4cRI0"}],"key":"Ux6ci8ru9R"}],"key":"uMOx2Vu5j0"}],"label":"fig-poiss","identifier":"fig-poiss","enumerator":"1","html_id":"fig-poiss","key":"mXqdtv1Ud4"},{"type":"thematicBreak","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"nRhVmL2LLX"},{"type":"heading","depth":2,"position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"The properties of Poisson uncertainty","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"sNB9kLxKIF"}],"identifier":"the-properties-of-poisson-uncertainty","label":"The properties of Poisson uncertainty","html_id":"the-properties-of-poisson-uncertainty","implicit":true,"key":"OwE5qeJ9ws"},{"type":"paragraph","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"Let us apply the property lens carefully.","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"bVOON5dpgG"}],"key":"qqeuDqyv6b"},{"type":"heading","depth":3,"position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"Typicality","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"Kb6J1dslXl"}],"identifier":"typicality","label":"Typicality","html_id":"typicality","implicit":true,"key":"yTXKKfVQea"},{"type":"paragraph","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"text","value":"There is a meaningful average number of events, λ, and most observations cluster around it. If λ equals 10 emails per hour, you will most often observe something close to 10.","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"JHEkeo4ORv"}],"key":"AvVqvFXF0v"},{"type":"paragraph","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"However, unlike the normal distribution, the Poisson distribution is not always symmetric. When λ is small, counts below the mean cannot go below zero, so the distribution stretches more easily upward than downward.","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"Q8E124sZmK"}],"key":"DkTRdPcszZ"},{"type":"heading","depth":3,"position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"text","value":"Extremeness","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"ZpWgkwcMKA"}],"identifier":"extremeness","label":"Extremeness","html_id":"extremeness","implicit":true,"key":"gSEyhicHwt"},{"type":"paragraph","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"children":[{"type":"text","value":"Large bursts of events are possible but increasingly rare. To observe an unusually high count, many independent event opportunities must align within the same interval.","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"key":"FaBxnLhJ8U"}],"key":"qjRpfD62Jm"},{"type":"paragraph","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"children":[{"type":"text","value":"This means that clusters of events can occur even in completely random systems. Seeing five customers enter within a short span does not necessarily imply hidden coordination. It may simply reflect natural variability.","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"JTqa8TaeAM"}],"key":"WeYoiZpFMh"},{"type":"paragraph","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"text","value":"Understanding this prevents us from attributing patterns to intention when randomness is sufficient explanation.","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"TVNHixeiEY"}],"key":"Wvb0mxYQBu"},{"type":"heading","depth":3,"position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"Memory","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"OMIw2hsngY"}],"identifier":"memory","label":"Memory","html_id":"memory","implicit":true,"key":"ESg4gh0rBs"},{"type":"paragraph","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"text","value":"The Poisson model assumes that events occur independently over time and that the rate does not change.","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"OqqwJlfzJK"}],"key":"zoGkLtKEGq"},{"type":"paragraph","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"text","value":"If five emails arrived in the previous hour, that fact does not alter the expected number in the next hour, provided the underlying rate remains constant.","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"YExSUXIBth"}],"key":"GYadXHIs5k"},{"type":"paragraph","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"At the same time, if you enlarge the observation window—say from one hour to two—the expected count doubles. The structure scales predictably with time.","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"h6sbbBtmzm"}],"key":"gMO7LIBrSa"},{"type":"heading","depth":3,"position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"text","value":"Accumulation","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"mXk2gknw11"}],"identifier":"accumulation","label":"Accumulation","html_id":"accumulation","implicit":true,"key":"FFDTLHdvp7"},{"type":"paragraph","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"text","value":"Counts accumulate linearly with the length of the interval. If the average rate is λ per hour, then over two hours the expected count is ( 2\\lambda ).","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"h93sO5m6Yq"}],"key":"hoWicmKsm3"},{"type":"paragraph","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"However, variability accumulates as well. Longer windows allow more fluctuation in absolute terms, even if the relative variation stabilizes.","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"vE2JYbUyij"}],"key":"que91fWIJk"},{"type":"heading","depth":3,"position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"text","value":"Predictive Horizon","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"qSJL0P2Xpb"}],"identifier":"predictive-horizon","label":"Predictive Horizon","html_id":"predictive-horizon","implicit":true,"key":"qArZXvZth6"},{"type":"paragraph","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"text","value":"You cannot predict the exact number of events in the next hour. But you can predict the typical range with reasonable confidence.","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"B3KLpl7uvr"}],"key":"c14lWZzIGs"},{"type":"paragraph","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"text","value":"The larger the interval, the more stable the relative average becomes, even though the raw counts may grow.","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"ao6OyBNJYJ"}],"key":"WYam0S2Odu"},{"type":"thematicBreak","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"key":"ocBhKXxaLy"},{"type":"heading","depth":2,"position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"children":[{"type":"text","value":"Where Poisson uncertainty appears in real life","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"UBk3QGGIoJ"}],"identifier":"where-poisson-uncertainty-appears-in-real-life","label":"Where Poisson uncertainty appears in real life","html_id":"where-poisson-uncertainty-appears-in-real-life","implicit":true,"key":"LnyzQZGhYH"},{"type":"paragraph","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"text","value":"The Poisson distribution appears whenever we count independent events occurring at a steady average rate.","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"key":"qUvsiDv9dQ"}],"key":"ZPIx7uelIV"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":128,"column":1},"end":{"line":134,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The number of emails received per hour","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"rfncejOz45"}],"key":"RHQe2E7s5g"}],"key":"r2vxPBXNx2"},{"type":"listItem","spread":true,"position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The number of customers entering a shop per day","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"ocUPJaD4LY"}],"key":"Rrl3x7S8kY"}],"key":"T4v7eJ7q6n"},{"type":"listItem","spread":true,"position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The number of typing errors on a page","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"asj6l1wQSI"}],"key":"f2yDNJkez9"}],"key":"fNSAFK7SwH"},{"type":"listItem","spread":true,"position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The number of calls arriving at a call center","position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"key":"hnGG7pOnvE"}],"key":"X7ckUfHPaL"}],"key":"JPAClfRVCe"},{"type":"listItem","spread":true,"position":{"start":{"line":132,"column":1},"end":{"line":132,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The number of small defects in manufactured goods","position":{"start":{"line":132,"column":1},"end":{"line":132,"column":1}},"key":"qmEskXm5cs"}],"key":"W6PJhKjhvr"}],"key":"BsHm7irmgm"},{"type":"listItem","spread":true,"position":{"start":{"line":133,"column":1},"end":{"line":134,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The number of mutations occurring in a strand of DNA","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"ltWK7liMpL"}],"key":"HDyMdNuKvY"}],"key":"kTXeVWLbby"}],"key":"WkCGejSjCR"},{"type":"paragraph","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"children":[{"type":"text","value":"In each case, we are not concerned with the timing of a specific event, but with how many events occur within a defined window.","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"lvHlNIHDXs"}],"key":"gC2SOeyQFu"},{"type":"paragraph","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"text","value":"Modern systems rely heavily on this structure. Call centers are staffed based on expected arrival rates. Hospitals plan resources based on expected patient inflow. Internet servers allocate capacity based on expected request rates.","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"OAyXFfKZdU"}],"key":"Q19ePyvJRT"},{"type":"paragraph","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"children":[{"type":"text","value":"In such systems, understanding the distribution of counts is essential for stability.","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"YH4tXNF2g6"}],"key":"RDThSNR2TB"},{"type":"thematicBreak","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"tiHMVV2eOR"},{"type":"heading","depth":2,"position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"text","value":"When clusters deceive us","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"A6PhFqGlk4"}],"identifier":"when-clusters-deceive-us","label":"When clusters deceive us","html_id":"when-clusters-deceive-us","implicit":true,"key":"ybo1bDgIEy"},{"type":"paragraph","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"children":[{"type":"text","value":"Human intuition often struggles with clustered randomness.","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"key":"oaYuO1KpHn"}],"key":"cgxSYe9jYN"},{"type":"paragraph","position":{"start":{"line":147,"column":1},"end":{"line":147,"column":1}},"children":[{"type":"text","value":"If ten customers enter a café in five minutes, it may feel as though something unusual is happening. We are tempted to search for causes: a promotion, a nearby event, a coordinated arrival.","position":{"start":{"line":147,"column":1},"end":{"line":147,"column":1}},"key":"R9pWZ5ue3v"}],"key":"RGu71Ch85L"},{"type":"paragraph","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"children":[{"type":"text","value":"Sometimes there is a cause. But sometimes there is not.","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"key":"WWjbvh6LTi"}],"key":"TPv1oL0qta"},{"type":"paragraph","position":{"start":{"line":151,"column":1},"end":{"line":151,"column":1}},"children":[{"type":"text","value":"Random processes governed by the Poisson distribution naturally produce clusters. Randomness is uneven.","position":{"start":{"line":151,"column":1},"end":{"line":151,"column":1}},"key":"AqhyT0wvJk"}],"key":"SEjdPNQTBT"},{"type":"paragraph","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"text","value":"If the underlying rate remains constant, bursts and droughts can still occur. Recognizing this helps us resist overinterpreting patterns.","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"M4o9jKI51O"}],"key":"c5Y4ZyNgy2"},{"type":"paragraph","position":{"start":{"line":155,"column":1},"end":{"line":155,"column":1}},"children":[{"type":"text","value":"The presence of variation does not necessarily imply hidden structure.","position":{"start":{"line":155,"column":1},"end":{"line":155,"column":1}},"key":"Klz1tGWGFq"}],"key":"H8JdUuYZ11"},{"type":"thematicBreak","position":{"start":{"line":157,"column":1},"end":{"line":157,"column":1}},"key":"N2ZOHI824i"},{"type":"heading","depth":2,"position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"children":[{"type":"text","value":"How to act when events just happen","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"BVaXSX3eOp"}],"identifier":"how-to-act-when-events-just-happen","label":"How to act when events just happen","html_id":"how-to-act-when-events-just-happen","implicit":true,"key":"a9JmLp8D9p"},{"type":"paragraph","position":{"start":{"line":161,"column":1},"end":{"line":161,"column":1}},"children":[{"type":"text","value":"In Poisson environments, the central task is calibration rather than prediction.","position":{"start":{"line":161,"column":1},"end":{"line":161,"column":1}},"key":"GaXNWwt1pH"}],"key":"RlIbdAOFbu"},{"type":"paragraph","position":{"start":{"line":163,"column":1},"end":{"line":163,"column":1}},"children":[{"type":"text","value":"You estimate the average rate. You monitor whether it remains stable. You design systems that can absorb fluctuation around that rate.","position":{"start":{"line":163,"column":1},"end":{"line":163,"column":1}},"key":"XZsVLMvQFy"}],"key":"x7nZNrP70o"},{"type":"paragraph","position":{"start":{"line":165,"column":1},"end":{"line":165,"column":1}},"children":[{"type":"text","value":"If the average number of calls per hour is known, you do not panic when one hour exceeds it slightly. Nor do you assume a trend based on a single burst.","position":{"start":{"line":165,"column":1},"end":{"line":165,"column":1}},"key":"eWlS29SCkK"}],"key":"iU7hIe7KGX"},{"type":"paragraph","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"children":[{"type":"text","value":"At the same time, you remain attentive to sustained shifts in λ. If the average rate changes, the entire structure shifts with it.","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"key":"YKOXMY5n57"}],"key":"S15RRMbGeA"},{"type":"paragraph","position":{"start":{"line":169,"column":1},"end":{"line":169,"column":1}},"children":[{"type":"text","value":"The practical lesson is not to suppress variability, but to understand its scale. Events will cluster. Gaps will occur. Counts will fluctuate. These fluctuations are part of the structure.","position":{"start":{"line":169,"column":1},"end":{"line":169,"column":1}},"key":"vZNzp2fnWx"}],"key":"HGWTi1LDbh"},{"type":"paragraph","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"children":[{"type":"text","value":"Wisdom lies in distinguishing between normal variation and structural change.","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"key":"rqhTnxE8eh"}],"key":"yEixIZ2fHt"},{"type":"thematicBreak","position":{"start":{"line":173,"column":1},"end":{"line":173,"column":1}},"key":"xAIQ8aLxJi"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Pitfall: Mistaking clusters for causes","position":{"start":{"line":175,"column":1},"end":{"line":175,"column":1}},"key":"RxyHisT0Vg"}],"key":"ZwuiBHQXje"},{"type":"paragraph","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"children":[{"type":"text","value":"Clusters of events can arise naturally in random systems.","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"LCZJyWrHIW"}],"key":"ggWA5MVLkK"},{"type":"paragraph","position":{"start":{"line":180,"column":1},"end":{"line":180,"column":1}},"children":[{"type":"text","value":"Do not assume that bursts imply intention, coordination, or malfunction unless the average rate itself has changed.","position":{"start":{"line":180,"column":1},"end":{"line":180,"column":1}},"key":"F2gN1cvBs2"}],"key":"lndLiPVPnJ"},{"type":"paragraph","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"children":[{"type":"text","value":"Randomness is not evenly spaced.","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"y2bDtMj88D"}],"key":"miLZouVG2G"}],"class":"pitfall","key":"uhZwxmhdNr"},{"type":"thematicBreak","position":{"start":{"line":185,"column":1},"end":{"line":185,"column":1}},"key":"hngDH6rnHJ"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Exercise: Counting Without Overreacting","position":{"start":{"line":187,"column":1},"end":{"line":187,"column":1}},"key":"biVOYM0LqD"}],"key":"SlpHXZtvOF"},{"type":"paragraph","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"children":[{"type":"text","value":"Think of a situation where you observed a burst of events and assumed something unusual was happening.","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"cYcxhMUjV7"}],"key":"lYelHlosGz"},{"type":"paragraph","position":{"start":{"line":192,"column":1},"end":{"line":192,"column":1}},"children":[{"type":"text","value":"Examples:","position":{"start":{"line":192,"column":1},"end":{"line":192,"column":1}},"key":"vOZVQ4TxdT"}],"key":"CAm7eZknAX"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":194,"column":1},"end":{"line":198,"column":1