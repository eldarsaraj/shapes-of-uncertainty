line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"This does not mean you will succeed exactly on the fourth or tenth try. It means that across many repetitions of the entire process, the average number of attempts before success will settle near that value.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"tplJuhLXxF"}],"key":"AS79HWo97w"},{"type":"paragraph","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"In this structure, there is no central “typical” number in the same sense as the normal distribution. The distribution is skewed. Most successes happen relatively early, but the possibility of long sequences of failure pulls the average outward.","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"ys3eQIKqiz"}],"key":"n6m40kEx9P"},{"type":"thematicBreak","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"PHvSaPeD5X"},{"type":"heading","depth":2,"position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"The properties of geometric uncertainty","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"W7OeuZMVoA"}],"identifier":"the-properties-of-geometric-uncertainty","label":"The properties of geometric uncertainty","html_id":"the-properties-of-geometric-uncertainty","implicit":true,"key":"PWi5ilH3QH"},{"type":"paragraph","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"Let us examine the structure more carefully.","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"mJXBHhlw80"}],"key":"wi2FP2P6Ob"},{"type":"heading","depth":3,"position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"Typicality","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"krnLXLkcYH"}],"identifier":"typicality","label":"Typicality","html_id":"typicality","implicit":true,"key":"VxJuUmgOEr"},{"type":"paragraph","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"There is no symmetric center here. The most likely outcome is often success on the first attempt. After that, probabilities decrease gradually.","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"W2Y5501Sat"}],"key":"KB692x8ELO"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"The average number of attempts exists and can be calculated, but it does not describe the most common case in the same way the mean does in a normal distribution. The distribution is right-skewed: many short sequences, a few long ones.","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"JdC7KyK3PI"}],"key":"AcjSIWNDc4"},{"type":"heading","depth":3,"position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"Extremeness","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"vXEYZKwhGg"}],"identifier":"extremeness","label":"Extremeness","html_id":"extremeness","implicit":true,"key":"TUb9b4ZXTu"},{"type":"paragraph","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"Long streaks of failure are possible, though progressively less likely. They are not structural impossibilities; they are simply rare.","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"e2LOj5tlcr"}],"key":"ItqULj71FQ"},{"type":"paragraph","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"text","value":"In real life, this means that even with a reasonable probability of success, some individuals may experience many failures before achieving success. This does not necessarily imply hidden forces or declining probability. It may simply reflect the mathematics of repetition.","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"sXPPnw5XOF"}],"key":"DoDn3Qn1nu"},{"type":"heading","depth":3,"position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"Memory","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"gleOgdXoor"}],"identifier":"memory","label":"Memory","html_id":"memory","implicit":true,"key":"Jyw48TNiID"},{"type":"paragraph","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"text","value":"The geometric distribution, like the exponential distribution in continuous time, is memoryless.","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"key":"g36EtN97Ms"}],"key":"airsprywim"},{"type":"paragraph","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"If you have failed five times already, the probability of success on the next attempt remains ","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"WxZCAmezs8"}],"key":"oWCW7c70Ap"},{"type":"math","value":"p","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"tight":true,"html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>p</mi></mrow><annotation encoding=\"application/x-tex\">p</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">p</span></span></span></span></span>","enumerator":"4","key":"qQ3f7aCoKJ"},{"type":"paragraph","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":". It does not increase simply because you have tried repeatedly.","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"odyuIboeZW"}],"key":"JTjZBuKXHM"},{"type":"paragraph","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"children":[{"type":"text","value":"This property often surprises people. We tend to believe that persistence must “build momentum.” In a purely geometric process, it does not.","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"VjNT1sWWVx"}],"key":"MZnVx1lkVW"},{"type":"heading","depth":3,"position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"text","value":"Accumulation","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"g8Qisu3NKR"}],"identifier":"accumulation","label":"Accumulation","html_id":"accumulation","implicit":true,"key":"dwCV9fA3eO"},{"type":"paragraph","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"text","value":"Attempts accumulate, but probability does not shift. What accumulates is experience, not probability.","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"sXmUVC4rre"}],"key":"PanayI8fhq"},{"type":"paragraph","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"text","value":"In reality, many human processes involve learning, which changes the probability of success. When that happens, the geometric model no longer applies. But under the strict assumptions of constant success probability, nothing about previous failures alters the chance of success on the next trial.","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"qycxZGjPfV"}],"key":"mNJ5A74EUu"},{"type":"heading","depth":3,"position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"text","value":"Predictive Horizon","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"TvsI5cq8Ou"}],"identifier":"predictive-horizon","label":"Predictive Horizon","html_id":"predictive-horizon","implicit":true,"key":"sTwD6QKJNt"},{"type":"paragraph","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"text","value":"You cannot predict exactly which attempt will succeed. However, you can estimate how many attempts are typically required on average.","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"o5Yz44rXnv"}],"key":"GqpY24uezG"},{"type":"paragraph","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"text","value":"The predictive power lies not in timing the exact moment of success, but in understanding the expected scale of persistence required.","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"Ps32yESINq"}],"key":"swc7dnnjrX"},{"type":"thematicBreak","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"uKO9udzuKn"},{"type":"heading","depth":2,"position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"text","value":"Where geometric uncertainty appears in real life","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"fXmfhalqz5"}],"identifier":"where-geometric-uncertainty-appears-in-real-life","label":"Where geometric uncertainty appears in real life","html_id":"where-geometric-uncertainty-appears-in-real-life","implicit":true,"key":"ca0MZnpAiO"},{"type":"paragraph","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"text","value":"This structure appears whenever success is defined as the first occurrence of a desired outcome under repeated, independent attempts.","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"key":"kNjll57XLu"}],"key":"lcn1H3fyaV"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":125,"column":1},"end":{"line":130,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Submitting job applications when each application has a similar chance of success","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"zAx6Pyabbd"}],"key":"ar4Vdo86yh"}],"key":"ivMuibaKzg"},{"type":"listItem","spread":true,"position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Cold-calling potential clients","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"key":"hb2X09BhY0"}],"key":"ufVPmmZyTh"}],"key":"wOgclP5PT0"},{"type":"listItem","spread":true,"position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Repeatedly attempting a competitive exam under similar preparation levels","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"nJQsJJRc2G"}],"key":"CP07S5ZJqt"}],"key":"zdWuUn8X68"},{"type":"listItem","spread":true,"position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Sales interactions where each interaction has a fixed probability of conversion","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"Vq71JaFSmU"}],"key":"eI1WTy5rgh"}],"key":"cT4qvdcCnq"},{"type":"listItem","spread":true,"position":{"start":{"line":129,"column":1},"end":{"line":130,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Randomized experimental trials in laboratory settings","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"yAb5TReRbX"}],"key":"H0Lq0OXdFE"}],"key":"bikpKFrYv2"}],"key":"PeTmg14d6I"},{"type":"paragraph","position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"text","value":"In such contexts, the number of attempts before success varies widely across individuals. Some succeed early. Others require many attempts. The variation itself is part of the structure.","position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"key":"rsJFIGTp4D"}],"key":"v3ZHYJlG1e"},{"type":"paragraph","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"text","value":"Importantly, the geometric model assumes independence and constant probability. In many real-world situations, experience modifies skill, and probability changes over time. When that occurs, the process becomes more complex than pure geometric repetition.","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"n6y5hhT8Qt"}],"key":"fvzDyLbdg7"},{"type":"thematicBreak","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"VBGGZmov2m"},{"type":"heading","depth":2,"position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"text","value":"The temptation of “I’m due”","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"jXDFULGnBQ"}],"identifier":"the-temptation-of-im-due","label":"The temptation of “I’m due”","html_id":"the-temptation-of-im-due","implicit":true,"key":"UtiCWH78ln"},{"type":"paragraph","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"children":[{"type":"text","value":"One of the most persistent cognitive errors in geometric environments is the belief that after many failures, success becomes more likely simply because of the failures.","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"ghTLKfhh0J"}],"key":"MFXrFFBWda"},{"type":"paragraph","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"text","value":"A student who has failed several interviews may feel that they are “due” for success. A salesperson after many rejections may believe the next call must convert.","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"Xa1RY2We77"}],"key":"XX1sK0PC0t"},{"type":"paragraph","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"text","value":"Under the assumptions of the geometric model, this reasoning does not hold. Each attempt carries the same probability as before.","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"ijHb61aBcR"}],"key":"dsSDc0C4ux"},{"type":"paragraph","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"children":[{"type":"text","value":"The feeling of being “due” arises from confusion between cumulative experience and cumulative probability. In strictly independent trials, probability resets each time.","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"key":"tPdN9F3Uw3"}],"key":"pSmyguJhwa"},{"type":"paragraph","position":{"start":{"line":147,"column":1},"end":{"line":147,"column":1}},"children":[{"type":"text","value":"Recognizing this distinction prevents both despair and false confidence.","position":{"start":{"line":147,"column":1},"end":{"line":147,"column":1}},"key":"K8lDFTMnOd"}],"key":"ILtxCqZCfI"},{"type":"thematicBreak","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"key":"pDuxYFDEHH"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Pitfall: Mistaking persistence for probability","position":{"start":{"line":151,"column":1},"end":{"line":151,"column":1}},"key":"zOJvU5fbhI"}],"key":"fBBwLOqehb"},{"type":"paragraph","position":{"start":{"line":154,"column":1},"end":{"line":154,"column":1}},"children":[{"type":"text","value":"Repeated attempts do not automatically increase the probability of success unless something about the process changes.","position":{"start":{"line":154,"column":1},"end":{"line":154,"column":1}},"key":"KxvYvtSQjr"}],"key":"vJOqIp8kNn"},{"type":"paragraph","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"children":[{"type":"text","value":"If learning, strategy, or conditions improve, probability may increase. But in a strictly geometric setting, each trial is independent and identical.","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"dykvBaPVRj"}],"key":"WAAzYGwxTp"},{"type":"paragraph","position":{"start":{"line":158,"column":1},"end":{"line":158,"column":1}},"children":[{"type":"text","value":"Do not assume that failure creates momentum.","position":{"start":{"line":158,"column":1},"end":{"line":158,"column":1}},"key":"U0SeWNLPlQ"}],"key":"UJj9TkCXIj"}],"class":"pitfall","key":"ffOMiJTDhg"},{"type":"thematicBreak","position":{"start":{"line":161,"column":1},"end":{"line":161,"column":1}},"key":"kCDrYp98Me"},{"type":"heading","depth":2,"position":{"start":{"line":163,"column":1},"end":{"line":163,"column":1}},"children":[{"type":"text","value":"How to act under geometric uncertainty","position":{"start":{"line":163,"column":1},"end":{"line":163,"column":1}},"key":"OdT7XnXbSU"}],"identifier":"how-to-act-under-geometric-uncertainty","label":"How to act under geometric uncertainty","html_id":"how-to-act-under-geometric-uncertainty","implicit":true,"key":"xtEkPo1x9l"},{"type":"paragraph","position":{"start":{"line":165,"column":1},"end":{"line":165,"column":1}},"children":[{"type":"text","value":"In geometric environments, rational persistence depends on two factors: the probability of success per attempt and the cost of each attempt.","position":{"start":{"line":165,"column":1},"end":{"line":165,"column":1}},"key":"Uh6KB7E9K3"}],"key":"wDyjzINvlR"},{"type":"paragraph","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"children":[{"type":"text","value":"If the probability of success is meaningful and the cost per trial is low, repeated attempts can be rational even when success is uncertain. The expected number of attempts provides guidance about the scale of effort required.","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"key":"y89VZBkFyq"}],"key":"Ko6FKWuc89"},{"type":"paragraph","position":{"start":{"line":169,"column":1},"end":{"line":169,"column":1}},"children":[{"type":"text","value":"However, blind persistence without evaluation can be wasteful. If the probability of success is extremely low, or if costs are high, continued repetition may not be justified.","position":{"start":{"line":169,"column":1},"end":{"line":169,"column":1}},"key":"HydkThCxUv"}],"key":"oM6mUbkh1j"},{"type":"paragraph","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"children":[{"type":"text","value":"The key question becomes:","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"key":"D5zT0QfATP"}],"key":"hMIcYbZTID"},{"type":"paragraph","position":{"start":{"line":173,"column":1},"end":{"line":173,"column":1}},"children":[{"type":"text","value":"Is the probability constant, or can it be improved?","position":{"start":{"line":173,"column":1},"end":{"line":173,"column":1}},"key":"HiTzMkEWyf"}],"key":"R9oIM4IsDb"},{"type":"paragraph","position":{"start":{"line":175,"column":1},"end":{"line":175,"column":1}},"children":[{"type":"text","value":"If learning or strategy changes the probability of success, then the process is no longer purely geometric. In that case, effort can reshape the structure itself.","position":{"start":{"line":175,"column":1},"end":{"line":175,"column":1}},"key":"BGyPFfTfYF"}],"key":"gqMXvkpHWP"},{"type":"paragraph","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"children":[{"type":"text","value":"Understanding this distinction allows you to decide when persistence is rational and when adjustment is required.","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"key":"wZqNNBJpUC"}],"key":"LcOPc0lGQs"},{"type":"paragraph","position":{"start":{"line":179,"column":1},"end":{"line":179,"column":1}},"children":[{"type":"text","value":"It is worth noting that the geometric distribution has a close relative in continuous time: the exponential distribution. Both describe waiting until the first success, and both share the memoryless property. The difference lies in how time is structured. The geometric model assumes distinct, countable attempts—first try, second try, third try—each with the same probability of success. The exponential model assumes that time flows continuously and that the event can occur at any instant, with a constant rate per unit time. In this sense, the exponential distribution can be understood as the continuous-time analogue of the geometric distribution. When events unfold in rounds or attempts, the geometric model is appropriate. When events unfold in uninterrupted time, the exponential model becomes the natural choice.","position":{"start":{"line":179,"column":1},"end":{"line":179,"column":1}},"key":"jOX4iEEKQb"}],"key":"LqKDTtlkgn"},{"type":"thematicBreak","position":{"start":{"line":181,"column":1},"end":{"line":181,"column":1}},"key":"Uws0oGenFX"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Exercise: Counting the Attempts","position":{"start":{"line":183,"column":1},"end":{"line":183,"column":1}},"key":"eoUSqLsyAC"}],"key":"mD5V0RmxcK"},{"type":"paragraph","position":{"start":{"line":186,"column":1},"end":{"line":186,"column":1}},"children":[{"type":"text","value":"Think of a situation in your own life where you had to try repeatedly before succeeding.","position":{"start":{"line":186,"column":1},"end":{"line":186,"column":1}},"key":"kQC0Ju1G0O"}],"key":"EVfDMvnirs"},{"type":"paragraph","position":{"start":{"line":188,"column":1},"end":{"line":188,"column":1}},"children":[{"type":"text","value":"Examples:","position":{"start":{"line":188,"column":1},"end":{"line":188,"column":1}},"key":"rBxbBHpSVF"}],"key":"z4BIMGVEvA"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":190,"column":1},"end":{"line":194,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Applying for internships or jobs","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"UpB47refVw"}],"key":"rdjp1cABWd"}],"key":"YAu2mEzYVt"},{"type":"listItem","spread":true,"position":{"start":{"line":191,"column":1},"end":{"line":191,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Attempting a competitive exam","position":{"start":{"line":191,"column":1},"end":{"line":191,"column":1}},"key":"ERH17C5Nyu"}],"key":"iHoRn20CXy"}],"key":"C6DwgeQpCi"},{"type":"listItem","spread":true,"position":{"start":{"line":192,"column":1},"end":{"line":192,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Learning a difficult skill","position":{"start":{"line":192,"column":1},"end":{"line":192,"column":1}},"key":"zNpmYKCbPn"}],"key":"sBwVAL4hrd"}],"key":"xfHAjycLCT"},{"type":"listItem","spread":true,"position":{"start":{"line":193,"column":1},"end":{"line":194,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Trying to secure approval or acceptance","position":{"start":{"line":193,"column":1},"end":{"line":193,"column":1}},"key":"pFGho4s4us"}],"key":"wTilmTQub7"}],"key":"p2kcLCt5qE"}],"key":"uhG1TC54Md"},{"type":"paragraph","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"children":[{"type":"text","value":"Answer the following:","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"key":"wIHSYazy8M"}],"key":"Dl8885ufjz"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":197,"column":1},"end":{"line":201,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":197,"column":1},"end":{"line":197,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Approximately how many attempts did it take before success?","position":{"start":{"line":197,"column":1},"end":{"line":197,"column":1}},"key":"CmWSchqJe3"}],"key":"U6CZ6bpccq"}],"key":"r9OIDgT3BM"},{"type":"listItem","spread":true,"position":{"start":{"line":198,"column":1},"end":{"line":198,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Did the probability of success remain roughly constant across attempts, or did it change as you gained experience?","position":{"start":{"line":198,"column":1},"end":{"line":198,"column":1}},"key":"iakFqQqrCi"}],"key":"TJ6drxpdVs"}],"key":"O5l8tmJ3jt"},{"type":"listItem","spread":true,"position":{"start":{"line":199,"column":1},"end":{"line":199,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Were your failures independent, or did earlier attempts influence later outcomes?","position":{"start":{"line":199,"column":1},"end":{"line":199,"column":1}},"key":"wZuQkUq0Ia"}],"key":"hJM8RgXqpQ"}],"key":"ZNyE7YDdnF"},{"type":"listItem","spread":true,"position":{"start":{"line":200,"column":1},"end":{"line":201,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Looking back, was persistence alone sufficient, or did strategy need to change?","position":{"start":{"line":200,"column":1},"end":{"line":200,"column":1}},"key":"bU3xjsHbx7"}],"key":"tevSQ4xgon"}],"key":"qulXpJZais"}],"key":"CPAKN5Albk"},{"type":"paragraph","position":{"start":{"line":202,"column":1},"end":{"line":202,"column":1}},"children":[{"type":"text","value":"Explain your reasoning in plain language. Focus on structure rather than emotion.","position":{"start":{"line":202,"column":1},"end":{"line":202,"column":1}},"key":"SUV0XVVCgb"}],"key":"WZziNYnOAd"}],"class":"exercise","key":"hOi6DC5mYg"}],"key":"fQzk4lOBon"}],"key":"dWRi392YTJ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Waiting Without Memory","url":"/exponential","group":"The Shapes of Uncertainty"},"next":{"title":"When Events Just Happen","url":"/poisson","group":"The Shapes of Uncertainty"}}},"domain":"http://localhost:3000"}