":"text","value":"Assuming that an old bridge has the same failure probability as a new one can lead to catastrophic oversight. Assuming that a device that has lasted decades is “due” to fail only makes sense if aging actually increases hazard.","position":{"start":{"line":146,"column":1},"end":{"line":146,"column":1}},"key":"N4WicrGPiO"}],"key":"lusY3PAdvh"},{"type":"paragraph","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"children":[{"type":"text","value":"The reverse mistake is also possible. Some systems become more reliable after surviving early defects. Assuming rising risk where it does not exist may cause unnecessary replacement.","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"key":"dIYCJKqwI9"}],"key":"m3vgWo4zoK"},{"type":"paragraph","position":{"start":{"line":150,"column":1},"end":{"line":150,"column":1}},"children":[{"type":"text","value":"Understanding whether hazard is increasing, decreasing, or constant is essential.","position":{"start":{"line":150,"column":1},"end":{"line":150,"column":1}},"key":"KaAO6uHPQI"}],"key":"KxChHjJYcb"},{"type":"paragraph","position":{"start":{"line":152,"column":1},"end":{"line":152,"column":1}},"children":[{"type":"text","value":"The Weibull distribution gives us a framework for expressing that structure explicitly.","position":{"start":{"line":152,"column":1},"end":{"line":152,"column":1}},"key":"FWk9toR6VY"}],"key":"TjSE5Zwwp5"},{"type":"thematicBreak","position":{"start":{"line":154,"column":1},"end":{"line":154,"column":1}},"key":"t8gzNA1gD7"},{"type":"heading","depth":2,"position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"children":[{"type":"text","value":"How to act under time-dependent risk","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"jd5LLpxJYF"}],"identifier":"how-to-act-under-time-dependent-risk","label":"How to act under time-dependent risk","html_id":"how-to-act-under-time-dependent-risk","